VITE_SERVER_BASE_URL=http://localhost:3200
VITE_SERVER_VERSION=v2

# Env-controlled visibility for the Admin pages (Site Config sidebar, Manage
# Features categories). All optional; unset = show everything (default).
# VITE_ADMIN_CLEAN_MODE=true                                    # hide Auth/GenAI/SSO/Email/Secret/Staging in Site Config, and show only Unlimited model/Admin in Manage Features
# VITE_ADMIN_HIDDEN_SITE_CONFIG_SECTIONS=auth,genai,sso,email,secrets,staging  # override which Site Config sections to hide
# VITE_ADMIN_VISIBLE_FEATURE_CATEGORIES=Unlimited model,Admin   # override which Manage Features categories to show