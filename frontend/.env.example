VITE_SERVER_BASE_URL=http://localhost:3200
VITE_SERVER_VERSION=v2

# Admin page visibility — runtime source of truth is the backend process env
# (ADMIN_CLEAN_MODE / ADMIN_HIDDEN_SITE_CONFIG_SECTIONS /
# ADMIN_VISIBLE_FEATURE_CATEGORIES, served by GET /v2/site-config/admin-ui).
# These VITE_* vars are build-time fallbacks only (e.g. frontend-only Playwright).
# VITE_ADMIN_CLEAN_MODE=true
# VITE_ADMIN_HIDDEN_SITE_CONFIG_SECTIONS=auth,genai,sso,email,secrets,staging
# VITE_ADMIN_VISIBLE_FEATURE_CATEGORIES=Unlimited model,Admin