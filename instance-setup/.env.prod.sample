NAME=autowrx
FRONTEND_PORT=3201
NODE_ENV=production

# Default deployment mode: read secrets from this file.
# Set SECRETS_PROVIDER=keyvault to opt in to Azure Key Vault.
SECRETS_PROVIDER=env
AZURE_KEY_VAULT_NAME=
AZURE_KEY_VAULT_ALLOW_ENV_FALLBACK=false

# Environment-mode secrets. Keep the real .env.prod file private.
MONGODB_URL=mongodb://autowrx-db:27017/autowrx
JWT_SECRET=replace-with-a-strong-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional JWT key rotation. JWT_SECRET stays required: it verifies tokens issued
# before rotation and derives the at-rest encryption key, so never change it.
# JWT_KEYS={"2026-10":"replace-with-a-strong-random-secret"}
# JWT_ACTIVE_KID=2026-10
# After JWT_REFRESH_EXPIRATION_DAYS, stop accepting JWT_SECRET-signed tokens:
# JWT_ACCEPT_LEGACY_SECRET=false

# Reverse-proxy hops in front of the backend (1 = one nginx/traefik). Use false
# when the backend port is exposed directly, otherwise clients can spoof their IP
# and bypass auth rate limits.
# TRUST_PROXY=1
# AUTH_RATE_LIMITS={"login":{"max":20}}

# Required non-secret configuration
CORS_ORIGINS=localhost:\d+,127\.0\.0\.1,digital\.auto,.*\.digital\.auto,.*\.digitalauto\.tech
ADMIN_EMAILS=admin@email.com

# Azure mode example:
# SECRETS_PROVIDER=keyvault
# AZURE_KEY_VAULT_NAME=your-key-vault-name
# MONGODB_URL, JWT_SECRET, and ADMIN_PASSWORD can then be omitted because
# they are loaded from Key Vault.

# GenAI service (deprecated sidecar proxy — use EXTERNAL_GENAI_* on backend instead)
# GENAI_URL=http://genai-proxy:8080
EXTERNAL_GENAI_URL=http://genai:8080
EXTERNAL_GENAI_DEVICE_TOKEN=replace-with-a-device-token
# EXTERNAL_GENAI_URL_DEV=
# EXTERNAL_GENAI_URL_PROD=
# EXTERNAL_GENAI_URL_STAGING=

# Kit server (internal docker-compose service)
# KIT_SERVER_URL=http://kit-server:3090

# Runtime HTTP preview proxy (kit HTTP UI is :8080 on the compose network; 3090 is kit-manager)
# Compose: RUNTIME_NAME → docker service host, port 8080 implied
# RUNTIME_SERVICE_MAPPINGS=PUBLIC-01-49aa7a20cb8aaf10:runtime-09,PUBLIC-02-985bfbf92e0a1698:runtime-10
# Host-run backend (outside compose): include host:port
# RUNTIME_SERVICE_MAPPINGS=PUBLIC-01-49aa7a20cb8aaf10:127.0.0.1:8889

# Comma-separated list of external domains allowed for api_data_url in model
# creation (SSRF protection). Leave empty to only allow relative paths.
# VSS_DATA_URL_ALLOWLIST=raw.githubusercontent.com,example.com
