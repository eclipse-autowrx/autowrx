NAME=autowrx
FRONTEND_PORT=3201
NODE_ENV=production
SECRETS_PROVIDER=keyvault
AZURE_KEY_VAULT_NAME=your-key-vault-name
# Set true only for an intentional offline/emergency start using .env secrets.
AZURE_KEY_VAULT_ALLOW_ENV_FALLBACK=false
CORS_ORIGINS=localhost:\d+,127\.0\.0\.1:\d+,digital\.auto,.*\.digital\.auto,.*\.digitalauto\.tech
ADMIN_EMAILS=admin@email.com
