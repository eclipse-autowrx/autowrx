# Frontend under test. Default: production build served by `vite preview`
# on port 3213 (playwright.config.ts starts it automatically — the app uses
# same-origin API calls through preview's proxy). To test a dev server
# instead: set E2E_DEV_SERVER=1, BASE_URL=http://localhost:3210, and start
# `npm run dev` in frontend/ yourself.
BASE_URL=http://localhost:3213
# Backend the tests talk to directly (setup/teardown, env guard). Also the
# target of the E2E_TEST_ENABLED fail-closed check.
API_URL=http://localhost:3200
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-password
